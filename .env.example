# =========================================================================
# Aurora Staff Management System Configuration
# Copy this file to '.env' and fill in your values
# =========================================================================

# MongoDB Atlas connection URI
MONGO_URI="mongodb+srv://admin123:admin123@cluster0.slklrau.mongodb.net/?appName=Cluster0"

# Flask Secret Key for session signing (use a secure random string in production)
SECRET_KEY="your_secret_key_here_change_this_in_production"

# Your Google OAuth Client ID (from Google Cloud Console Credentials page)
# NOTE: Ensure you add 'http://localhost:5000' to the Authorized JavaScript Origins.
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID_HERE.apps.googleusercontent.com"
